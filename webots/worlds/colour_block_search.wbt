#VRML_SIM R2023b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "Applied Robotics and AI Project - Part 2"
    "e-puck searches a 3 m x 3 m arena for four coloured blocks (0.3 x 0.3 x 0.1 m)."
  ]
  title "Colour Block Search"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.5 0.5 0.7 2.0
  position 0 -4.2 4.6
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 3 3
  floorTileSize 0.5 0.5
  wallHeight 0.15
}
DEF BLOCK_RED Solid {
  translation 0.9 0.9 0.05
  children [
    Shape {
      appearance PBRAppearance { baseColor 1 0 0 roughness 1 metalness 0 }
      geometry DEF BLOCK_BOX Box { size 0.3 0.3 0.1 }
    }
  ]
  name "red block"
  boundingObject USE BLOCK_BOX
  physics Physics { density -1 mass 0.5 }
}
DEF BLOCK_GREEN Solid {
  translation -0.9 0.9 0.05
  children [
    Shape {
      appearance PBRAppearance { baseColor 0 0.8 0 roughness 1 metalness 0 }
      geometry Box { size 0.3 0.3 0.1 }
    }
  ]
  name "green block"
  boundingObject Box { size 0.3 0.3 0.1 }
  physics Physics { density -1 mass 0.5 }
}
DEF BLOCK_BLUE Solid {
  translation -0.9 -0.9 0.05
  children [
    Shape {
      appearance PBRAppearance { baseColor 0 0.2 1 roughness 1 metalness 0 }
      geometry Box { size 0.3 0.3 0.1 }
    }
  ]
  name "blue block"
  boundingObject Box { size 0.3 0.3 0.1 }
  physics Physics { density -1 mass 0.5 }
}
DEF BLOCK_YELLOW Solid {
  translation 0.9 -0.9 0.05
  children [
    Shape {
      appearance PBRAppearance { baseColor 1 0.9 0 roughness 1 metalness 0 }
      geometry Box { size 0.3 0.3 0.1 }
    }
  ]
  name "yellow block"
  boundingObject Box { size 0.3 0.3 0.1 }
  physics Physics { density -1 mass 0.5 }
}
E-puck {
  translation 0 0 0
  controller "epuck_colour_detector"
  camera_width 160
  camera_height 120
}
Robot {
  name "block randomiser"
  controller "block_randomiser"
  supervisor TRUE
}
