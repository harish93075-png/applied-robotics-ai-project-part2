EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/animals/protos/Deer.proto"

WorldInfo {
  info [
    "CNN camera test: miniature CIFAR-10 objects (dog, cat, horse, deer, airplane) inside a walled 3 m x 3 m arena."
    "Four 8 cm coloured blocks (red, green, blue, yellow) share the arena. Every run the epuck_controller (tour mode)"
    "shuffles everything, then the e-puck drives to each object: it photographs the CIFAR objects for the CNN"
    "and identifies each block colour with HSV thresholding."
  ]
  title "CNN Object Test"
  basicTimeStep 32
}
Viewpoint {
  orientation -0.3205 0.3205 0.8913 1.6856
  position 0 -3.3 2.75
}
TexturedBackground {
}
